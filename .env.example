# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# CONFIGURACIÓN PARA RENDER (BACKEND)
# ==========================================
# PORT: Puerto de ejecución en Render (Render asigna 10000 por defecto)
PORT=10000

# CORS_ORIGIN: URL de tu frontend en Vercel (ej: https://of-sparta.vercel.app o * para todos)
CORS_ORIGIN="*"

# FREE_FIRE_API_KEY: Tu clave API de Gameskinbo (API Primaria)
FREE_FIRE_API_KEY=""

# FREE_FIRE_BACKUP_API_KEY: Tu segunda clave API de Gameskinbo (Respaldo por límite de cuota)
FREE_FIRE_BACKUP_API_KEY=""

# WHATSAPP_WEBHOOK_URL: Webhook de Make.com o n8n para enviar WhatsApp sin consumir los 512MB de Render
WHATSAPP_WEBHOOK_URL=""

# MONGO_URI: Enlace de conexión de MongoDB Atlas (opcional)
MONGO_URI=""

# LEADER_PASSWORD: La contraseña secreta que solo tú y tus líderes sabrán para ver registros y botar/eliminar
LEADER_PASSWORD="MiClanFF2026*"

# ==========================================
# CONFIGURACIÓN PARA VERCEL (FRONTEND)
# ==========================================
# VITE_API_URL: La URL pública de tu backend en Render (ej: https://of-sparta-backend.onrender.com)
VITE_API_URL=""
